[user]
	name = FLC
	email = paulespling@gmail.com

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = tokyonight

# Delta theme: Soft dark-toned tint tuned for TokyoNight
[delta "tokyonight"]
	dark = true
	line-numbers = true
	minus-style = syntax "#2e1a24"
	minus-emph-style = syntax bold "#612438"
	plus-style = syntax "#162824"
	plus-emph-style = syntax bold "#235342"

[merge]
	conflictstyle = zdiff3

[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager

[credential "https://dev.azure.com"]
	useHttpPath = true
